{
  "name": "ai-learning-hub-admin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "test:media": "node scripts/check-media.mjs",
    "build": "npm run version:check && npm run typecheck && vite build && node ../scripts/version.mjs artifact admin-web",
    "check": "npm run lint && npm run typecheck && npm run build",
    "preview": "vite preview",
    "version:check": "node ../scripts/version.mjs check admin-web"
  },
  "dependencies": {
    "@ai-learning-hub/contracts": "file:../packages/contracts",
    "@antv/g2": "^5.4.1",
    "element-plus": "^2.11.7",
    "pinia": "^3.0.3",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.5"
  }
}
