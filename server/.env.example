# 本地开发配置；正式 Compose 使用 deploy/compose/.env.production.example。
DEPLOYMENT_PROFILE=experience
VITE_DATA_MODE=api
DATABASE_URL=postgresql://app_user:change-me@127.0.0.1:5432/ai_learning_hub
LOAD_DEMO_DATA=false
COMMUNITY_STARTER_PACK=none
COMMUNITY_STARTER_CREDENTIALS_FILE=./var/initialization/community-accounts.json
JWT_SECRET=change-me
MFA_DATA_KEY=
IDENTITY_DATA_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=true
SWAGGER_ENABLED=false
ADMIN_NETWORK_CIDRS=127.0.0.1/32,::1/128
CORS_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:4174
FRONTEND_URL=http://127.0.0.1:4173
ADMIN_WEB_URL=http://127.0.0.1:4174
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./var/uploads
VIDEO_UPLOAD_MAX_MB=1024
RESOURCE_ATTACHMENT_MAX_MB=100
VIDEO_PLAYBACK_SECRET=
VIDEO_ORPHAN_RETENTION_HOURS=168
# 文件、上传和视频任务容量；按实际磁盘或对象存储配额配置。
STORAGE_USER_QUOTA_BYTES=10737418240
# 本地0=自动探测；S3/MinIO必须显式填写实际容量。
STORAGE_CAPACITY_BYTES=0
STORAGE_MIN_FREE_BYTES=2147483648
STORAGE_PARALLEL_UPLOADS_PER_USER=2
STORAGE_PARALLEL_UPLOADS_TOTAL=16
VIDEO_QUEUED_PER_USER=3
VIDEO_QUEUED_TOTAL=50
MEDIA_TEMP_PATH=
# 空值表示未扫描；配置后失败或风险文件将隔离。
MEDIA_CLAMSCAN_PATH=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ALLOW_INSECURE=false
REGISTRATION_INVITE_HASHES=
TRUSTED_PROXY_CIDRS=
QUIZ_BOX_BASE_URL=
QUIZ_BOX_CLIENT_ID=
QUIZ_BOX_CLIENT_SECRET=
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_SECRET=
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=
SEED_STUDENT_EMAIL=student@example.invalid
SEED_STUDENT_PASSWORD=
## 小雪助手：仅服务端读取，未配置时问答明确返回不可用。
ASSISTANT_MODEL_BASE_URL=https://api.deepseek.com
ASSISTANT_MODEL_NAME=deepseek-flash
ASSISTANT_MODEL_API_KEY=
