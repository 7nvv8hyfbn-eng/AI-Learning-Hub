enum MediaAssetKind {
  cover
  hero
  illustration
  icon_preview
}

enum MediaAssetSource {
  upload
  image2_seed
  system
}

enum MediaAssetStatus {
  active
  archived
}

model MediaAsset {
  id          String             @id @default(cuid())
  assetKey    String             @unique @map("asset_key")
  fileId      String             @unique @map("file_id")
  name        String
  kind        MediaAssetKind     @default(cover)
  source      MediaAssetSource   @default(upload)
  contentType String             @default("global") @map("content_type")
  categoryKey String             @default("generic") @map("category_key")
  altText     String             @default("") @map("alt_text")
  width       Int
  height      Int
  focalX      Float              @default(0.5) @map("focal_x")
  focalY      Float              @default(0.5) @map("focal_y")
  status      MediaAssetStatus   @default(active)
  createdBy   String?            @map("created_by")
  revision    Int                @default(1)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")
  file        FileRecord         @relation(fields: [fileId], references: [id], onDelete: Restrict)
  defaults    MediaDefaultRule[]
  themes      Theme[]
  courses     Course[]
  labs        Lab[]
  resources   Resource[]
  articles    Article[]
  challenges  Challenge[]

  @@index([status, kind, contentType, categoryKey])
  @@map("media_assets")
}

model MediaDefaultRule {
  id          String     @id @default(cuid())
  contentType String     @map("content_type")
  categoryKey String     @map("category_key")
  assetId     String     @map("asset_id")
  active      Boolean    @default(true)
  revision    Int        @default(1)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
