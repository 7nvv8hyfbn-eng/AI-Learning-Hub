  videoPlayableFiles      VideoAsset[]           @relation("VideoAssetPlayable")
  videoPosters            VideoAsset[]           @relation("VideoAssetPoster")

  @@index([checksum])
  @@index([uploadedBy, storageDriver])
  @@index([reservationId])
  @@index([quarantinedAt])
  @@map("files")
}

model StorageReservation {
  id               String      @id @default(cuid())
  userId           String      @map("user_id")
