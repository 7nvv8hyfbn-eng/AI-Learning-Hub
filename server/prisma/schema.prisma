generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishStatus {
  draft
  reviewing
  published
  archived
}

enum UserStatus {
  active
  disabled
  locked
}

enum CampusIdentityVerificationStatus {
  pending
  approved
  rejected
  revoked
}

enum LabType {
  agent
  deployment
  command
  hardware
  project
}

enum LabRunStatus {
  ready
  running
  success
  failed
  stopped
  submitted
}

enum FavoriteTargetType {
  course
  lab
  resource
  article
}

enum QuestionType {
  single
  multiple
  true_false
  short_answer
  code
}

model User {
  id                        String                      @id @default(cuid())
  username                  String                      @unique
  displayName               String                      @map("display_name")
  email                     String                      @unique
  passwordHash              String?                     @map("password_hash")
  phone                     String?
  schoolId                  String?                     @map("school_id")
  departmentId              String?                     @map("department_id")
  studentNo                 String?                     @map("student_no")
  teacherNo                 String?                     @map("teacher_no")
  major                     String?
  grade                     String?
  userType                  String                      @default("student") @map("user_type")
  status                    UserStatus                  @default(active)
  revision                  Int                         @default(1)
  sessionVersion            Int                         @default(0) @map("session_version")
  profile                   Json                        @default("{}") @map("profile_json")
  lastLoginAt               DateTime?                   @map("last_login_at")
  emailVerifiedAt           DateTime?                   @map("email_verified_at")
  agreementVersion          String?                     @map("agreement_version")
  agreementAcceptedAt       DateTime?                   @map("agreement_accepted_at")
  registrationSource        String                      @default("legacy") @map("registration_source")
  onboardingCompletedAt     DateTime?                   @map("onboarding_completed_at")
  usernameChangedAt         DateTime?                   @map("username_changed_at")
  passwordResetTokens       PasswordResetToken[]
  emailVerificationTokens   EmailVerificationToken[]
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  refreshTokens             RefreshToken[]
  userRoles                 UserRole[]
  favorites                 Favorite[]
  notes                     LearningNote[]
  lessonProgress            LessonProgress[]
  labRuns                   LabRun[]
  attempts                  AssessmentAttempt[]
  assessmentAnswers         AssessmentAnswer[]
  wrongQuestions            WrongQuestion[]
  knowledgeStats            UserKnowledgeStat[]
  plans                     LearningPlan[]
  growthPoints              GrowthPoint[]
  activities                ActivityEvent[]
  uploadedFiles             FileRecord[]
  achievements              UserAchievement[]
  certificates              UserCertificate[]
  identities                AuthIdentity[]
  loginLogs                 LoginLog[]
  notificationReads         NotificationRead[]
  recommendations           UserRecommendation[]
  courseAssignments         CourseInstructor[]
  resourceDownloads         ResourceDownload[]
  resourceViews             ResourceView[]
  articleViews              ArticleView[]
  challengeScores           ChallengeBestScore[]
  school                    School?                     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  department                Department?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  communityProfile          CommunityProfile?
  communityPosts            CommunityPost[]
  authoredContentReviews    ContentReview[]             @relation("ContentReviewAuthor")
  submittedContentReviews   ContentReview[]             @relation("ContentReviewSubmitter")
  reviewedContentReviews    ContentReview[]             @relation("ContentReviewReviewer")
  communityComments         CommunityComment[]
  communityReactions        CommunityPostReaction[]
  communityCommentReactions CommunityCommentReaction[]
  communityBookmarks        CommunityBookmark[]
  communityFollowing        CommunityUserFollow[]       @relation("CommunityFollower")
  communityFollowers        CommunityUserFollow[]       @relation("CommunityFollowee")
  communityTopicFollows     CommunityTopicFollow[]
  communityFeedback         CommunityFeedback[]
  videoAssets               VideoAsset[]
  storageReservations       StorageReservation[]
  learningCollections       LearningCollection[]        @relation("LearningCollectionOwner")
  collectionCourseLinks     CollectionCourseReference[] @relation("CollectionCourseCreator")
  communityRestrictions     CommunityOperationRestriction[] @relation("CommunityRestrictionUser")
  restrictionsCreated       CommunityOperationRestriction[] @relation("CommunityRestrictionCreator")
  restrictionsRevoked       CommunityOperationRestriction[] @relation("CommunityRestrictionRevoker")
  resourceWatchProgress     ResourceWatchProgress[]
  communityReports          CommunityReport[]
  profileReports            CommunityReport[] @relation("ReportedProfile")
  receivedModeration        CommunityModerationAction[] @relation("ModerationSubject")
  communityAppeals          CommunityAppeal[]
  communityModeration       CommunityModerationAction[]
  communityImpressions      CommunityFeedImpression[]
  communityNotifications    UserNotification[]
  communitySignalSnapshot   UserFeedSignalSnapshot?
  communityFeedSessions     CommunityFeedSession[]
  identityVerification      CampusIdentityVerification?  @relation("CampusIdentityOwner")
  identityReviews           CampusIdentityVerification[]  @relation("CampusIdentityReviewer")

  @@index([status, createdAt])
  @@index([schoolId, status])
  @@index([registrationSource, createdAt])
  @@index([lastLoginAt])
  @@map("users")
}

model School {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  status      String       @default("active")
  departments Department[]
  users       User[]

  @@map("schools")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model RegistrationThrottle {
  identityKey String   @id @map("identity_key")
  attempts    Int      @default(1)
  expiresAt   DateTime @map("expires_at")

  @@map("registration_throttles")
}

model CampusIdentityVerification {
  id                    String                           @id @default(cuid())
  userId                String                           @unique @map("user_id")
  realNameEncrypted     String                           @map("real_name_encrypted")
  idNumberEncrypted     String                           @map("id_number_encrypted")
  idNumberFingerprint   String                           @map("id_number_fingerprint")
  idNumberLast4         String                           @map("id_number_last4")
  className             String                           @map("class_name")
  studentNo             String                           @map("student_no")
  status                CampusIdentityVerificationStatus @default(pending)
  submittedAt           DateTime                         @default(now()) @map("submitted_at")
  reviewedAt            DateTime?                        @map("reviewed_at")
  reviewedById          String?                          @map("reviewed_by_id")
  reviewReason          String?                          @map("review_reason")
  revision              Int                              @default(1)
  createdAt             DateTime                         @default(now()) @map("created_at")
  updatedAt             DateTime                         @updatedAt @map("updated_at")
  user                   User                             @relation("CampusIdentityOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy             User?                            @relation("CampusIdentityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([idNumberFingerprint])
  @@index([studentNo, status])
  @@index([reviewedAt])
  @@map("campus_identity_verifications")
}

model Department {
  id       String @id @default(cuid())
  schoolId String @map("school_id")
  code     String
  name     String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users    User[]

  @@unique([schoolId, code])
  @@map("departments")
}

model AuthIdentity {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  provider    String
  providerUid String   @map("provider_uid")
  metadata    Json     @default("{}") @map("metadata_json")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@unique([userId, provider])
  @@map("auth_identities")
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  identifier String
  ipHash    String   @map("ip_hash")
  result    String
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, createdAt])
  @@map("login_logs")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model HomepageModule {
  id                    String                  @id @default(cuid())
  moduleKey             String                  @unique @map("module_key")
  name                  String
  moduleType            String                  @default("content_grid") @map("module_type")
  enabled               Boolean                 @default(true)
  sortOrder             Int                     @default(0) @map("sort_order")
  status                PublishStatus           @default(draft)
  config                Json                    @default("{}") @map("config_json")
  currentDraftVersionId String?                 @map("current_draft_version_id")
  publishedVersionId    String?                 @map("published_version_id")
  publishedAt           DateTime?               @map("published_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  items                 HomepageItem[]
  versions              HomepageModuleVersion[] @relation("HomepageModuleVersions")
  currentDraftVersion   HomepageModuleVersion?  @relation("HomepageModuleDraftVersion", fields: [currentDraftVersionId], references: [id], onDelete: SetNull)
  publishedVersion      HomepageModuleVersion?  @relation("HomepageModulePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  @@index([status, sortOrder])
  @@map("homepage_modules")
}

model HomepageModuleVersion {
  id           String           @id @default(cuid())
  moduleId     String           @map("module_id")
  versionNo    Int              @map("version_no")
  snapshot     Json
  createdAt    DateTime         @default(now()) @map("created_at")
  module       HomepageModule   @relation("HomepageModuleVersions", fields: [moduleId], references: [id], onDelete: Cascade)
  draftFor     HomepageModule[] @relation("HomepageModuleDraftVersion")
  publishedFor HomepageModule[] @relation("HomepageModulePublishedVersion")

  @@unique([moduleId, versionNo])
  @@map("homepage_module_versions")
}

model HomepagePublication {
  id          String   @id @default(cuid())
  version     Int      @unique
  snapshot    Json
  publishedAt DateTime @default(now()) @map("published_at")

  @@map("homepage_publications")
}

model HomepageItem {
  id              String         @id @default(cuid())
  moduleId        String         @map("module_id")
  targetType      String         @map("target_type")
  targetId        String         @map("target_id")
  titleOverride   String?        @map("title_override")
  summaryOverride String?        @map("summary_override")
  coverOverride   String?        @map("cover_override")
  sortOrder       Int            @default(0) @map("sort_order")
  enabled         Boolean        @default(true)
  module          HomepageModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, targetType, targetId])
  @@map("homepage_items")
}

model Theme {
  id                    String         @id @default(cuid())
  coverAssetId          String?        @map("cover_asset_id")
  coverAsset            MediaAsset?    @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)
  dataOrigin            String         @default("admin_created") @map("data_origin")
  slug                  String         @unique
  title                 String
  summary               String
  status                PublishStatus  @default(draft)
  sortOrder             Int            @default(0) @map("sort_order")
  publishedAt           DateTime?      @map("published_at")
  payload               Json           @default("{}")
  version               Int            @default(1)
  currentDraftVersionId String?        @map("current_draft_version_id")
  publishedVersionId    String?        @map("published_version_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  deletedAt             DateTime?      @map("deleted_at")
  courses               Course[]
  paths                 LearningPath[]
  versions              ThemeVersion[] @relation("ThemeVersions")
  currentDraftVersion   ThemeVersion?  @relation("ThemeDraftVersion", fields: [currentDraftVersionId], references: [id], onDelete: SetNull)
  publishedVersion      ThemeVersion?  @relation("ThemePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  @@index([status, sortOrder])
  @@map("learning_themes")
}

model ThemeVersion {
  id           String   @id @default(cuid())
  themeId      String   @map("theme_id")
  versionNo    Int      @map("version_no")
  snapshot     Json
  createdAt    DateTime @default(now()) @map("created_at")
  theme        Theme    @relation("ThemeVersions", fields: [themeId], references: [id], onDelete: Cascade)
  draftFor     Theme[]  @relation("ThemeDraftVersion")
  publishedFor Theme[]  @relation("ThemePublishedVersion")

  @@unique([themeId, versionNo])
  @@map("learning_theme_versions")
}

model LearningPath {
  id          String              @id @default(cuid())
  themeId     String              @map("theme_id")
  name        String
  description String              @default("")
  status      PublishStatus       @default(draft)
  sortOrder   Int                 @default(0) @map("sort_order")
  theme       Theme               @relation(fields: [themeId], references: [id], onDelete: Cascade)
  stages      LearningPathStage[]

  @@unique([themeId, name])
  @@index([themeId, status, sortOrder])
  @@map("learning_paths")
}

model LearningPathStage {
  id          String        @id @default(cuid())
  pathId      String        @map("path_id")
  stageKey    String        @map("stage_key")
  name        String
  stageType   String        @map("stage_type")
  description String        @default("")
  sortOrder   Int           @default(0) @map("sort_order")
  unlockRule  Json          @default("{}") @map("unlock_rule_json")
  path        LearningPath  @relation(fields: [pathId], references: [id], onDelete: Cascade)
  contents    PathContent[]

  @@unique([pathId, stageKey])
  @@index([pathId, sortOrder])
  @@map("learning_path_stages")
}

model PathContent {
  id         String            @id @default(cuid())
  stageId    String            @map("stage_id")
  targetType String            @map("target_type")
  targetId   String            @map("target_id")
  sortOrder  Int               @default(0) @map("sort_order")
  stage      LearningPathStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, targetType, targetId])
  @@map("learning_path_contents")
}

model Course {
  id                    String                      @id @default(cuid())
  coverAssetId          String?                     @map("cover_asset_id")
  coverAsset            MediaAsset?                 @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)
  dataOrigin            String                      @default("admin_created") @map("data_origin")
  slug                  String                      @unique
  title                 String
  summary               String
  themeId               String?                     @map("theme_id")
  status                PublishStatus               @default(draft)
  sortOrder             Int                         @default(0) @map("sort_order")
  publishedAt           DateTime?                   @map("published_at")
  payload               Json                        @default("{}")
  version               Int                         @default(1)
  currentDraftVersionId String?                     @map("current_draft_version_id")
  publishedVersionId    String?                     @map("published_version_id")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  deletedAt             DateTime?                   @map("deleted_at")
  theme                 Theme?                      @relation(fields: [themeId], references: [id], onDelete: SetNull)
  versions              CourseVersion[]             @relation("CourseVersions")
  currentDraftVersion   CourseVersion?              @relation("CourseDraftVersion", fields: [currentDraftVersionId], references: [id], onDelete: SetNull)
  publishedVersion      CourseVersion?              @relation("CoursePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  progress              LessonProgress[]
  notes                 LearningNote[]
  instructors           CourseInstructor[]
  resources             CourseResource[]
  labs                  CourseLab[]
  collectionReferences  CollectionCourseReference[]

  @@index([status, sortOrder])
  @@map("courses")
}

model CourseInstructor {
  id        String @id @default(cuid())
  courseId  String @map("course_id")
  userId    String @map("user_id")
  sortOrder Int    @default(0) @map("sort_order")
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([courseId, userId])
  @@map("course_instructors")
}

model CourseResource {
  id         String   @id @default(cuid())
  courseId   String   @map("course_id")
  resourceId String   @map("resource_id")
  sortOrder  Int      @default(0) @map("sort_order")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@unique([courseId, resourceId])
  @@map("course_resources")
}

model CourseLab {
  id        String @id @default(cuid())
  courseId  String @map("course_id")
  labId     String @map("lab_id")
  sortOrder Int    @default(0) @map("sort_order")
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lab       Lab    @relation(fields: [labId], references: [id], onDelete: Restrict)

  @@unique([courseId, labId])
  @@map("course_labs")
}

model CourseVersion {
  id                   String                      @id @default(cuid())
  courseId             String                      @map("course_id")
  versionNo            Int                         @map("version_no")
  snapshot             Json
  createdAt            DateTime                    @default(now()) @map("created_at")
  course               Course                      @relation("CourseVersions", fields: [courseId], references: [id], onDelete: Cascade)
  draftFor             Course[]                    @relation("CourseDraftVersion")
  publishedFor         Course[]                    @relation("CoursePublishedVersion")
  chapters             CourseChapter[]
  collectionReferences CollectionCourseReference[]

  @@unique([courseId, versionNo])
  @@map("course_versions")
}

model CourseChapter {
  id              String         @id @default(cuid())
  courseVersionId String         @map("course_version_id")
  title           String
  description     String         @default("")
  sortOrder       Int            @default(0) @map("sort_order")
  version         CourseVersion  @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  lessons         CourseLesson[]

  @@map("course_chapters")
}

model CourseLesson {
  id              String           @id @default(cuid())
  chapterId       String           @map("chapter_id")
  title           String
  summary         String           @default("")
  lessonType      String           @default("article") @map("lesson_type")
  durationMinutes Int              @default(10) @map("duration_minutes")
  sortOrder       Int              @default(0) @map("sort_order")
  chapter         CourseChapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  blocks          LessonBlock[]
  progress        LessonProgress[]
  notes           LearningNote[]

  @@map("course_lessons")
}

model LessonBlock {
  id        String       @id @default(cuid())
  lessonId  String       @map("lesson_id")
  blockType String       @map("block_type")
  sortOrder Int          @default(0) @map("sort_order")
  content   Json         @map("content_json")
  lesson    CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_blocks")
}

model LessonProgress {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  courseId        String        @map("course_id")
  lessonId        String?       @map("lesson_id")
  progress        Int           @default(0)
  positionSeconds Int           @default(0) @map("position_seconds")
  completedAt     DateTime?     @map("completed_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lesson          CourseLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId, lessonId])
  @@index([userId, updatedAt])
  @@map("lesson_progress")
}

model LearningNote {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  courseId  String        @map("course_id")
  lessonId  String?       @map("lesson_id")
  scopeKey  String        @default("course") @map("scope_key")
  content   String
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lesson    CourseLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, scopeKey])
  @@index([userId, updatedAt])
  @@map("learning_notes")
}

model Lab {
  id                    String           @id @default(cuid())
  coverAssetId          String?          @map("cover_asset_id")
  coverAsset            MediaAsset?      @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)
  dataOrigin            String           @default("admin_created") @map("data_origin")
  slug                  String           @unique
  title                 String
  summary               String
  labType               LabType          @map("lab_type")
  status                PublishStatus    @default(draft)
  sortOrder             Int              @default(0) @map("sort_order")
  publishedAt           DateTime?        @map("published_at")
  payload               Json             @default("{}")
  version               Int              @default(1)
  currentDraftVersionId String?          @map("current_draft_version_id")
  publishedVersionId    String?          @map("published_version_id")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  deletedAt             DateTime?        @map("deleted_at")
  steps                 LabStep[]
  runs                  LabRun[]
  versions              LabVersion[]     @relation("LabVersions")
  currentDraftVersion   LabVersion?      @relation("LabDraftVersion", fields: [currentDraftVersionId], references: [id], onDelete: SetNull)
  publishedVersion      LabVersion?      @relation("LabPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  courseLinks           CourseLab[]
  tools                 LabToolBinding[]
  resources             LabResource[]

  @@index([status, sortOrder])
  @@map("labs")
}

model LabTool {
  id           String           @id @default(cuid())
  name         String
  toolType     String           @map("tool_type")
  icon         String           @default("")
  description  String           @default("")
  configSchema Json             @default("{}") @map("config_schema_json")
  safeConfig   Json             @default("{}") @map("safe_config_json")
  enabled      Boolean          @default(true)
  bindings     LabToolBinding[]

  @@unique([name, toolType])
  @@map("lab_tools")
}

model LabToolBinding {
  id        String  @id @default(cuid())
  labId     String  @map("lab_id")
  toolId    String  @map("tool_id")
  sortOrder Int     @default(0) @map("sort_order")
  lab       Lab     @relation(fields: [labId], references: [id], onDelete: Cascade)
  tool      LabTool @relation(fields: [toolId], references: [id], onDelete: Restrict)

  @@unique([labId, toolId])
  @@map("lab_tool_bindings")
}

model LabResource {
  id         String   @id @default(cuid())
  labId      String   @map("lab_id")
  resourceId String   @map("resource_id")
  sortOrder  Int      @default(0) @map("sort_order")
  lab        Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

