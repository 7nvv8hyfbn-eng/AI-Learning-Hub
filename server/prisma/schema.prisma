}

model Notification {
  id          String             @id @default(cuid())
  title       String
  content     String
  audience    String             @default("all")
  status      PublishStatus      @default(draft)
  publishedAt DateTime?          @map("published_at")
  createdAt   DateTime           @default(now()) @map("created_at")
