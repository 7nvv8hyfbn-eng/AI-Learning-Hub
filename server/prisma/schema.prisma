}

enum CommunityPostType {
  question
  note
  lab_result
  project
  frontier_discussion
  achievement
  general
}

enum CommunityPostStatus {
  draft
  pending_review
  published
  limited
  hidden
  removed
}

enum CommunityVisibility {
  public
  school
}

enum CommunityReactionType {
  like
  useful
}

enum ResourceContributionKind {
  video
  article
  document
}

enum VideoProcessingStatus {
  uploaded
  processing
  ready
  failed
}

enum LearningCollectionVisibility {
  private
  community
}

model CommunityProfile {
  userId                 String         @id @map("user_id")
  revision               Int            @default(1)
  bio                    String         @default("")
  headline               String         @default("")
  avatarFileId           String?        @map("avatar_file_id")
  bannerFileId           String?        @map("banner_file_id")
  location               String?
  websiteUrl             String?        @map("website_url")
  pinnedPostId           String?        @map("pinned_post_id")
  verifiedType           String         @default("none") @map("verified_type")
  expertiseTopics        String[]       @default([]) @map("expertise_topics")
  allowAchievementDrafts Boolean        @default(false) @map("allow_achievement_drafts")
  postCount              Int            @default(0) @map("post_count")
  followerCount          Int            @default(0) @map("follower_count")
  followingCount         Int            @default(0) @map("following_count")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarFile             FileRecord?    @relation("CommunityProfileAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  bannerFile             FileRecord?    @relation("CommunityProfileBanner", fields: [bannerFileId], references: [id], onDelete: SetNull)
  pinnedPost             CommunityPost? @relation("CommunityProfilePinnedPost", fields: [pinnedPostId], references: [id], onDelete: SetNull)

  @@index([avatarFileId])
  @@index([bannerFileId])
  @@index([pinnedPostId])
  @@map("community_profiles")
}

model CommunityPost {
  coverFileId     String?                 @map("cover_file_id")
  coverFile       FileRecord?             @relation("CommunityPostCover", fields: [coverFileId], references: [id], onDelete: Restrict)
  moderationActions CommunityModerationAction[]
  id              String                  @id @default(cuid())
  revision        Int                     @default(1)
  authorId        String                  @map("author_id")
  postType        CommunityPostType       @map("post_type")
  status          CommunityPostStatus     @default(draft)
  visibility      CommunityVisibility     @default(public)
  schoolId        String?                 @map("school_id")
  title           String?
  body            String
  contentBlocks   Json                    @map("content_blocks")
  plainText       String                  @map("plain_text")
  sourceType      String?                 @map("source_type")
  sourceId        String?                 @map("source_id")
  contentHash     String                  @map("content_hash")
  labels          String[]                @default([])
  publishedAt     DateTime?               @map("published_at")
  editedAt        DateTime?               @map("edited_at")
  likeCount       Int                     @default(0) @map("like_count")
  usefulCount     Int                     @default(0) @map("useful_count")
  commentCount    Int                     @default(0) @map("comment_count")
  bookmarkCount   Int                     @default(0) @map("bookmark_count")
  impressionCount Int                     @default(0) @map("impression_count")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  deletedAt       DateTime?               @map("deleted_at")
  author          User                    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  bindings        CommunityPostBinding[]
  topics          CommunityPostTopic[]
  question        CommunityQuestionState?
  comments        CommunityComment[]
  reactions       CommunityPostReaction[]
  bookmarks       CommunityBookmark[]
  reports         CommunityReport[]
  revisions       CommunityPostRevision[]
  pinnedBy        CommunityProfile[]      @relation("CommunityProfilePinnedPost")
  contribution    ResourceContribution?

  @@index([status, publishedAt, id])
  @@index([authorId, status, publishedAt])
  @@index([schoolId, status, publishedAt])
  @@index([postType, status, publishedAt])
  @@index([contentHash, status])
  @@index([status, visibility, publishedAt, id])
  @@index([authorId, status, publishedAt, id])
  @@index([postType, status, publishedAt, id])
  @@index([schoolId, status, publishedAt, id])
  @@index([contentHash, authorId, status])
  @@index([deletedAt])
  @@map("community_posts")
}

model VideoAsset {
  id               String                  @id @default(cuid())
  uploaderId       String                  @map("uploader_id")
  sourceFileId     String                  @unique @map("source_file_id")
  playableFileId   String?                 @unique @map("playable_file_id")
  posterFileId     String?                 @unique @map("poster_file_id")
  status           VideoProcessingStatus   @default(uploaded)
  originalName     String                  @map("original_name")
  originalMimeType String                  @map("original_mime_type")
  durationSeconds  Int?                    @map("duration_seconds")
  width            Int?
  height           Int?
  rotation         Int                     @default(0)
  videoCodec       String?                 @map("video_codec")
  audioCodec       String?                 @map("audio_codec")
  attempts         Int                     @default(0)
  claimedAt        DateTime?               @map("claimed_at")
  claimToken       String?                 @map("claim_token")
  leaseExpiresAt   DateTime?               @map("lease_expires_at")
  reservationId    String?                 @unique @map("reservation_id")
  startedAt        DateTime?               @map("started_at")
  finishedAt       DateTime?               @map("finished_at")
  lastError        String?                 @map("last_error")
  version          Int                     @default(1)
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  uploader         User                    @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  reservation      StorageReservation?     @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  sourceFile       FileRecord              @relation("VideoAssetSource", fields: [sourceFileId], references: [id], onDelete: Restrict)
  playableFile     FileRecord?             @relation("VideoAssetPlayable", fields: [playableFileId], references: [id], onDelete: Restrict)
  posterFile       FileRecord?             @relation("VideoAssetPoster", fields: [posterFileId], references: [id], onDelete: Restrict)
  contribution     ResourceContribution?
  progress         ResourceWatchProgress[]

  @@index([status, claimedAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([uploaderId, createdAt])
  @@map("video_assets")
}

model ResourceContribution {
  postId               String                   @id @map("post_id")
  kind                 ResourceContributionKind
  categoryId           String?                  @map("category_id")
  videoAssetId         String?                  @unique @map("video_asset_id")
  attachmentFileId     String?                  @map("attachment_file_id")
  coverFileId          String?                  @map("cover_file_id")
  tags                 String[]                 @default([])
  teachingReuseConsent Boolean                  @default(false) @map("teaching_reuse_consent")
  sourceName           String?                  @map("source_name")
  sourceUrl            String?                  @map("source_url")
  featured             Boolean                  @default(false)
  liveReplay           Boolean                  @default(false) @map("live_replay")
  revision             Int                      @default(1)
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  post                 CommunityPost            @relation(fields: [postId], references: [id], onDelete: Cascade)
  category             ResourceCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  videoAsset           VideoAsset?              @relation(fields: [videoAssetId], references: [id], onDelete: Restrict)
  attachmentFile       FileRecord?              @relation("ResourceContributionAttachment", fields: [attachmentFileId], references: [id], onDelete: Restrict)
  coverFile            FileRecord?              @relation("ResourceContributionCover", fields: [coverFileId], references: [id], onDelete: Restrict)
  collectionItems      LearningCollectionItem[]

  @@index([kind, categoryId, featured, updatedAt])
  @@index([categoryId, updatedAt])
  @@map("resource_contributions")
}

model LearningCollection {
  reports      CommunityReport[]
  moderationActions CommunityModerationAction[]
  id           String                       @id @default(cuid())
  ownerId      String                       @map("owner_id")
  name         String
  description  String                       @default("")
  learningGoal String                       @default("") @map("learning_goal")
  visibility   LearningCollectionVisibility @default(private)
  contentStatus String                      @default("published") @map("content_status")
  systemKind   String?                      @map("system_kind")
  revision     Int                          @default(1)
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime                     @updatedAt @map("updated_at")
  owner        User                         @relation("LearningCollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  items        LearningCollectionItem[]
  courseLinks  CollectionCourseReference[]

  @@unique([ownerId, systemKind])
  @@index([visibility, updatedAt])
  @@map("learning_collections")
}

model LearningCollectionItem {
  id                 String               @id @default(cuid())
  collectionId       String               @map("collection_id")
  contributionPostId String               @map("contribution_post_id")
  sortOrder          Int                  @default(0) @map("sort_order")
  createdAt          DateTime             @default(now()) @map("created_at")
  collection         LearningCollection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  contribution       ResourceContribution @relation(fields: [contributionPostId], references: [postId], onDelete: Restrict)

  @@unique([collectionId, contributionPostId])
  @@index([collectionId, sortOrder, id])
  @@map("learning_collection_items")
}

model ResourceWatchProgress {
  userId          String     @map("user_id")
  videoAssetId    String     @map("video_asset_id")
  positionSeconds Int        @default(0) @map("position_seconds")
  watchedSeconds  Int        @default(0) @map("watched_seconds")
  completedAt     DateTime?  @map("completed_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoAsset      VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)

  @@id([userId, videoAssetId])
  @@index([userId, updatedAt])
  @@map("resource_watch_progress")
}

model CollectionCourseReference {
  id              String             @id @default(cuid())
  collectionId    String             @map("collection_id")
  courseId        String             @map("course_id")
  courseVersionId String             @map("course_version_id")
  createdBy       String             @map("created_by")
  sourceRevision  Int                @map("source_revision")
  createdAt       DateTime           @default(now()) @map("created_at")
  collection      LearningCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  course          Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseVersion   CourseVersion      @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)
  creator         User               @relation("CollectionCourseCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([collectionId, courseId])
  @@index([courseId, createdAt])
  @@map("collection_course_references")
}

model CommunityPostBinding {
  id            String        @id @default(cuid())
  postId        String        @map("post_id")
  targetType    String        @map("target_type")
  targetId      String        @map("target_id")
  titleSnapshot String        @map("title_snapshot")
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  post          CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("community_post_bindings")
}

model CommunityQuestionState {
  postId            String            @id @map("post_id")
  status            String            @default("open")
  acceptedCommentId String?           @unique @map("accepted_comment_id")
  solvedAt          DateTime?         @map("solved_at")
  post              CommunityPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  acceptedComment   CommunityComment? @relation(fields: [acceptedCommentId], references: [id], onDelete: SetNull)

  @@map("community_question_states")
}

model CommunityComment {
  moderationActions CommunityModerationAction[]
  id            String                     @id @default(cuid())
  revision      Int                        @default(1)
  postId        String                     @map("post_id")
  authorId      String                     @map("author_id")
  parentId      String?                    @map("parent_id")
  rootId        String?                    @map("root_id")
  body          String
  contentBlocks Json                       @map("content_blocks")
  status        String                     @default("published")
  likeCount     Int                        @default(0) @map("like_count")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  deletedAt     DateTime?                  @map("deleted_at")
  post          CommunityPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User                       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent        CommunityComment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict)
  replies       CommunityComment[]         @relation("CommentReplies")
  acceptedFor   CommunityQuestionState?
  reactions     CommunityCommentReaction[]
  reports       CommunityReport[]

  @@index([postId, createdAt])
  @@index([postId, status, createdAt, id])
  @@index([authorId, createdAt])
  @@map("community_comments")
}

model CommunityPostReaction {
  userId       String                @map("user_id")
  postId       String                @map("post_id")
  reactionType CommunityReactionType @map("reaction_type")
  createdAt    DateTime              @default(now()) @map("created_at")
  post         CommunityPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId, reactionType])
  @@map("community_post_reactions")
}

model CommunityCommentReaction {
  userId       String                @map("user_id")
  commentId    String                @map("comment_id")
  reactionType CommunityReactionType @default(like) @map("reaction_type")
  createdAt    DateTime              @default(now()) @map("created_at")
  comment      CommunityComment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, commentId, reactionType])
  @@map("community_comment_reactions")
}

model CommunityBookmark {
  userId    String        @map("user_id")
  postId    String        @map("post_id")
  createdAt DateTime      @default(now()) @map("created_at")
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@map("community_bookmarks")
}

model CommunityUserFollow {
  followerId String   @map("follower_id")
  followeeId String   @map("followee_id")
  createdAt  DateTime @default(now()) @map("created_at")
  follower   User     @relation("CommunityFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("CommunityFollowee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
  @@map("community_user_follows")
}

model CommunityTopic {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  name          String
  description   String                 @default("")
  accent        String                 @default("purple")
  themeId       String?                @map("theme_id")
  status        String                 @default("active")
  recommended   Boolean                @default(false)
  sortOrder     Int                    @default(0) @map("sort_order")
  postCount     Int                    @default(0) @map("post_count")
  followerCount Int                    @default(0) @map("follower_count")
  posts         CommunityPostTopic[]
  follows       CommunityTopicFollow[]

  @@map("community_topics")
}

model CommunityPostTopic {
  postId  String         @map("post_id")
  topicId String         @map("topic_id")
  post    CommunityPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  topic   CommunityTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([postId, topicId])
  @@index([topicId])
  @@map("community_post_topics")
}

model CommunityTopicFollow {
  userId    String         @map("user_id")
  topicId   String         @map("topic_id")
  createdAt DateTime       @default(now()) @map("created_at")
  topic     CommunityTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@map("community_topic_follows")
}

model CommunityFeedback {
  id           String             @id @default(cuid())
  userId       String             @map("user_id")
  targetId     String             @map("target_id")
  feedbackType String             @map("feedback_type")
  postType     CommunityPostType? @map("post_type")
  createdAt    DateTime           @default(now()) @map("created_at")
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId, feedbackType])
  @@index([userId, feedbackType])
  @@index([targetId, feedbackType])
  @@map("community_feedback")
}

model CommunityReport {
  id          String            @id @default(cuid())
  reporterId  String            @map("reporter_id")
  postId      String?           @map("post_id")
  commentId   String?           @map("comment_id")
  profileId   String?           @map("profile_id")
  collectionId String?          @map("collection_id")
  category    String            @default("other")
  evidence    String[]          @default([])
  contentRevision Int?          @map("content_revision")
  revision    Int               @default(1)
  assignedToId String?          @map("assigned_to_id")
  claimedAt   DateTime?         @map("claimed_at")
  dueAt       DateTime          @default(dbgenerated("(now() + '2 days'::interval)")) @map("due_at")
  resultReason String           @default("") @map("result_reason")
  actionId    String?           @map("action_id")
  targetKey   String            @map("target_key")
  reason      String
  description String            @default("")
  status      String            @default("pending")
  handledBy   String?           @map("handled_by")
  handledAt   DateTime?         @map("handled_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  post        CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment     CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter    User              @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  profile     User?             @relation("ReportedProfile", fields: [profileId], references: [id], onDelete: Restrict)
  collection  LearningCollection? @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  moderationAction CommunityModerationAction? @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@unique([reporterId, targetKey])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@map("community_reports")
}

model ContentReview {
  assignedToId String? @map("assigned_to_id")
  claimedAt DateTime? @map("claimed_at")
  dueAt DateTime @default(dbgenerated("(now() + '2 days'::interval)")) @map("due_at")
  appeals CommunityAppeal[]
  id              String   @id @default(cuid())
  targetType      String   @map("target_type")
  targetId        String   @map("target_id")
  contentRevision Int      @map("content_revision")
  ruleVersion     Int      @map("rule_version")
  authorId        String   @map("author_id")
  submittedById   String   @map("submitted_by_id")
  action          String
  status          String
  findings        Json
  payload         Json     @default("{}")
  reviewedById    String?  @map("reviewed_by_id")
  reason          String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")
  reviewedAt      DateTime? @map("reviewed_at")
  author          User     @relation("ContentReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  submittedBy     User     @relation("ContentReviewSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy      User?    @relation("ContentReviewReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@unique([targetType, targetId, contentRevision])
  @@index([status, createdAt, id])
  @@index([authorId, createdAt])
  @@map("content_reviews")
}

model CommunityModerationAction {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  action     String
  reason     String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  subjectId  String?  @map("subject_id")
  postId     String?  @map("post_id")
  commentId  String?  @map("comment_id")
  collectionId String? @map("collection_id")
  contentRevision Int? @map("content_revision")
  ruleCode   String   @default("") @map("rule_code")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  revokedById String? @map("revoked_by_id")
  revokeReason String @default("") @map("revoke_reason")
  revision   Int @default(1)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  subject    User? @relation("ModerationSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  post       CommunityPost? @relation(fields: [postId], references: [id], onDelete: Restrict)
  comment    CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Restrict)
  collection LearningCollection? @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  reports CommunityReport[]
  appeals CommunityAppeal[]
  restriction CommunityOperationRestriction?

  @@index([targetType, targetId, createdAt])
  @@index([subjectId, action, revokedAt, expiresAt])
  @@index([postId, action, revokedAt, expiresAt])
  @@index([commentId, action, revokedAt, expiresAt])
  @@index([collectionId, action, revokedAt, expiresAt])
  @@map("community_moderation_actions")
}

model CommunityOperationRestriction {
  moderationActionId String? @unique @map("moderation_action_id")
  moderationAction CommunityModerationAction? @relation(fields: [moderationActionId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  operations  String[]
  reason      String
  startsAt    DateTime  @default(now()) @map("starts_at")
  endsAt      DateTime  @map("ends_at")
  createdById String    @map("created_by_id")
  revokedAt   DateTime? @map("revoked_at")
  revokedById String?   @map("revoked_by_id")
  revision    Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation("CommunityRestrictionUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("CommunityRestrictionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  revokedBy   User?     @relation("CommunityRestrictionRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, endsAt])
  @@index([endsAt])
  @@map("community_operation_restrictions")
}

model CommunityAppeal {
  id String @id @default(cuid())
  authorId String @map("author_id")
  actionId String? @map("action_id")
  reviewId String? @map("review_id")
  requestHash String @map("request_hash")
  reason String
  evidence String[] @default([])
  status String @default("pending")
  revision Int @default(1)
  assignedToId String? @map("assigned_to_id")
  claimedAt DateTime? @map("claimed_at")
  dueAt DateTime @default(dbgenerated("(now() + '2 days'::interval)")) @map("due_at")
  resultReason String @default("") @map("result_reason")
  handledById String? @map("handled_by_id")
  handledAt DateTime? @map("handled_at")
  createdAt DateTime @default(now()) @map("created_at")
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  moderationAction CommunityModerationAction? @relation(fields: [actionId], references: [id], onDelete: Restrict)
  review ContentReview? @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@unique([authorId, requestHash])
  @@index([status, dueAt, createdAt])
  @@index([authorId, createdAt])
  @@map("community_appeals")
}

model CommunityFeedImpression {
  requestId       String    @map("request_id")
  viewerId        String    @map("viewer_id")
  postId          String    @map("post_id")
  position        Int
  candidateSource String    @map("candidate_source")
  policyVersion   String    @map("policy_version")
  reasonCodes     String[]  @map("reason_codes")
  scoreBucket     Int       @map("score_bucket")
  impressedAt     DateTime? @map("impressed_at")
  clickedAt       DateTime? @map("clicked_at")
  dwellMs         Int       @default(0) @map("dwell_ms")
  viewer          User      @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([requestId, postId])
  @@index([viewerId, impressedAt])
  @@index([postId, impressedAt])
  @@map("community_feed_impressions")
}

model UserNotification {
  id               String    @id @default(cuid())
  recipientId      String    @map("recipient_id")
  actorId          String?   @map("actor_id")
  notificationType String    @map("notification_type")
  entityType       String    @map("entity_type")
  entityId         String    @map("entity_id")
  dedupeKey        String    @unique @map("dedupe_key")
  payload          Json      @default("{}")
  actorIds         String[]  @default([]) @map("actor_ids")
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  recipient        User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([entityType, entityId])
  @@map("user_notifications")
}

model CommunityPostRevision {
  coverFileIdSnapshot    String?       @map("cover_file_id_snapshot")
  id                    String        @id @default(cuid())
  postId                String        @map("post_id")
  revisionNo            Int           @map("revision_no")
  editorId              String        @map("editor_id")
  editorType            String        @map("editor_type")
  titleSnapshot         String?       @map("title_snapshot")
  contentBlocksSnapshot Json          @map("content_blocks_snapshot")
  bindingsSnapshot      Json          @map("bindings_snapshot")
  topicIdsSnapshot      String[]      @map("topic_ids_snapshot")
  visibilitySnapshot    String        @map("visibility_snapshot")
  statusSnapshot        String        @map("status_snapshot")
  reason                String        @default("")
  createdAt             DateTime      @default(now()) @map("created_at")
  post                  CommunityPost @relation(fields: [postId], references: [id], onDelete: Restrict)

  @@unique([postId, revisionNo])
  @@map("community_post_revisions")
}

model RequestIdempotency {
  id               String   @id @default(cuid())
  principalKey     String   @map("principal_key")
  scope            String
  idempotencyKey   String   @map("idempotency_key")
  requestHash      String   @map("request_hash")
  resourceId       String   @map("resource_id")
  responseStatus   Int      @default(200) @map("response_status")
  responseSnapshot Json     @default("{}") @map("response_snapshot")
  status           String   @default("completed")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([principalKey, scope, idempotencyKey])
  @@index([expiresAt])
  @@map("request_idempotency")
}

model UserFeedSignalSnapshot {
  userId                  String   @id @map("user_id")
  topicAffinity           Json     @default("{}") @map("topic_affinity")
  authorAffinity          Json     @default("{}") @map("author_affinity")
  postTypeAffinity        Json     @default("{}") @map("post_type_affinity")
  learningContentAffinity Json     @default("{}") @map("learning_content_affinity")
  negativeFeedback        Json     @default("{}") @map("negative_feedback")
  updatedAt               DateTime @updatedAt @map("updated_at")
  version                 Int      @default(1)
  eventCount              Int      @default(0) @map("event_count")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_feed_signal_snapshots")
}

model CommunityFeedSession {
  id            String   @id @default(cuid())
  viewerId      String   @map("viewer_id")
  mode          String
  contentType   String   @map("content_type")
  policyVersion String   @map("policy_version")
  entries       Json
  context       Json
  degraded      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  expiresAt     DateTime @map("expires_at")
  viewer        User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("community_feed_sessions")
}
