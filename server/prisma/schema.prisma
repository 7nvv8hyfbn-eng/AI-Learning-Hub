}

model GrowthModuleSetting {
  id           String  @id @default(cuid())
  moduleKey    String  @unique @map("module_key")
  title        String
  description  String  @default("")
  enabled      Boolean @default(true)
  sortOrder    Int     @default(0) @map("sort_order")
  displayLimit Int     @default(6) @map("display_limit")
  config       Json    @default("{}") @map("config_json")

  @@map("growth_module_settings")
}

model ActivityEvent {
  id         String   @id @default(cuid())
  eventKey   String?  @unique @map("event_key")
  actionType String?  @map("action_type")
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  source     String   @default("student-web")
  userId     String?  @map("user_id")
  eventType  String   @map("event_type")
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  payload    Json     @default("{}")
  surface    String?  @map("surface")
  sessionId  String?  @map("session_id")
  requestId  String?  @map("request_id")
  position   Int?
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId, occurredAt])
  @@index([userId, actionType, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("activity_events")
}

model DailyUserStatistic {
  id              String   @id @default(cuid())
  date            DateTime @unique @db.Date
  activeUsers     Int      @default(0) @map("active_users")
  learningMinutes Int      @default(0) @map("learning_minutes")

