  createdAt DateTime @default(now()) @map("created_at")
  attempts  Int      @default(0)
  lastError String?  @map("last_error")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("media_gc_jobs")
}

model FileRecord {
  id                      String                 @id @default(cuid())
  storageDriver           String                 @map("storage_driver")
  objectKey               String                 @unique @map("object_key")
  originalName            String                 @map("original_name")
  extension               String
  mimeType                String                 @map("mime_type")
  size                    Int
  checksum                String
  visibility              String                 @default("private")
  uploadedBy              String                 @map("uploaded_by")
  createdAt               DateTime               @default(now()) @map("created_at")
  reservationId           String?                @map("reservation_id")
  scanStatus              String                 @default("not_scanned") @map("scan_status")
  scanMessage             String?                @map("scan_message")
  scannedAt               DateTime?              @map("scanned_at")
  quarantinedAt           DateTime?              @map("quarantined_at")
  reservation             StorageReservation?    @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  uploader                User                   @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  resources               Resource[]
  mediaAsset              MediaAsset?
