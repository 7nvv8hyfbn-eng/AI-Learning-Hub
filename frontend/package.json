{
  "name": "ai-learning-hub-frontend",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build:mock": "npm run typecheck && vite build --mode mock",
    "lint": "eslint .",
    "build:catalog": "tsc -p ../packages/catalog-assets/tsconfig.json",
    "typecheck": "npm run build:catalog && vue-tsc --noEmit",
    "test": "vitest run",
    "build": "npm run version:check && npm run typecheck && vite build && node ../scripts/version.mjs artifact frontend",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "preview": "vite preview",
    "version:check": "node ../scripts/version.mjs check frontend"
  },
  "dependencies": {
    "@ai-learning-hub/catalog-assets": "file:../packages/catalog-assets",
    "@ai-learning-hub/contracts": "file:../packages/contracts",
    "@ai-learning-hub/demo-fixtures": "file:../packages/demo-fixtures",
    "@vue-flow/core": "^1.48.2",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "@xterm/xterm": "^6.0.0",
    "cropperjs": "2.2.0",
    "dompurify": "^3.4.15",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "jsdom": "30.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.1.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.6"
  }
}
