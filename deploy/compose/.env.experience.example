# 仅用于受控局域网 HTTP 体验；不满足正式 HTTPS 部署条件。
DEPLOYMENT_PROFILE=experience
VITE_DATA_MODE=api
APP_COMMIT_SHA=local
LOAD_DEMO_DATA=false
BIND_ADDRESS=127.0.0.1
ADMIN_BIND_ADDRESS=127.0.0.1
STUDENT_PORT=8080
ADMIN_PORT=8081
FRONTEND_URL=http://127.0.0.1:8080
ADMIN_WEB_URL=http://127.0.0.1:8081
CORS_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:8081
# 仅此 HTTP 体验模板显式关闭 Secure；应用和 Compose 默认均为 true。
COOKIE_SECURE=false
SWAGGER_ENABLED=false
POSTGRES_DB=ai_learning_hub
POSTGRES_USER=ai_hub
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=
MFA_DATA_KEY=
IDENTITY_DATA_KEY=
VIDEO_PLAYBACK_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_DAYS=7
PROXY_SUBNET=172.30.80.0/24
STUDENT_PROXY_IP=172.30.80.10
ADMIN_PROXY_IP=172.30.80.11
TRUSTED_PROXY_CIDRS=172.30.80.10/32,172.30.80.11/32
EXTERNAL_PROXY_CIDRS=
# 按真实管理电脑或 VPN 网段填写；空值只允许回环，不会放行整个学生网。
ADMIN_NETWORK_CIDRS=
STORAGE_DRIVER=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ALLOW_INSECURE=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
