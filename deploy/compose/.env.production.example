# 正式配置：填入校内 DNS、管理网/VPN 和可信反向代理。不可直接使用占位值部署。
DEPLOYMENT_PROFILE=production
VITE_DATA_MODE=api
APP_COMMIT_SHA=local
LOAD_DEMO_DATA=false
BIND_ADDRESS=127.0.0.1
ADMIN_BIND_ADDRESS=127.0.0.1
STUDENT_PORT=8080
ADMIN_PORT=8081
POSTGRES_DB=ai_learning_hub
POSTGRES_USER=ai_hub
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=
MFA_DATA_KEY=
IDENTITY_DATA_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=true
SWAGGER_ENABLED=false
CORS_ORIGINS=https://learn.campus.example,https://admin.campus.example
FRONTEND_URL=https://learn.campus.example
ADMIN_WEB_URL=https://admin.campus.example
# 校方代理实际出口 IP；同机代理也须核对 Docker 看到的对端，不可盲填整个内网。
EXTERNAL_PROXY_CIDRS=
ADMIN_NETWORK_CIDRS=
PROXY_SUBNET=172.30.80.0/24
STUDENT_PROXY_IP=172.30.80.10
ADMIN_PROXY_IP=172.30.80.11
TRUSTED_PROXY_CIDRS=172.30.80.10/32,172.30.80.11/32
STORAGE_DRIVER=local
VIDEO_UPLOAD_MAX_MB=1024
RESOURCE_ATTACHMENT_MAX_MB=100
VIDEO_PLAYBACK_SECRET=
VIDEO_ORPHAN_RETENTION_HOURS=168
# 文件、上传和视频任务容量；按实际磁盘或对象存储配额配置。
STORAGE_USER_QUOTA_BYTES=10737418240
# 本地0=自动探测；S3/MinIO必须显式填写实际容量。
STORAGE_CAPACITY_BYTES=0
STORAGE_MIN_FREE_BYTES=2147483648
STORAGE_PARALLEL_UPLOADS_PER_USER=2
STORAGE_PARALLEL_UPLOADS_TOTAL=16
VIDEO_QUEUED_PER_USER=3
VIDEO_QUEUED_TOTAL=50
MEDIA_TEMP_PATH=
# 空值表示未扫描；配置后失败或风险文件将隔离。
MEDIA_CLAMSCAN_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ALLOW_INSECURE=false
REGISTRATION_INVITE_HASHES=
# 仅全新空库首次创建管理员使用；既有管理员不被覆盖。
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
QUIZ_BOX_BASE_URL=
QUIZ_BOX_CLIENT_ID=
QUIZ_BOX_CLIENT_SECRET=
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_SECRET=
